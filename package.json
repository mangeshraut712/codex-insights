{
  "name": "codex-session-insights",
  "version": "0.2.3",
  "description": "Private, trust-aware reports from local Codex sessions. Community $insights skill inspired by Claude Code /insights.",
  "author": {
    "name": "mangeshraut712",
    "url": "https://github.com/mangeshraut712"
  },
  "type": "module",
  "bin": {
    "codex-session-insights": "bin/codex-insights.js"
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangeshraut712/codex-insights.git"
  },
  "homepage": "https://github.com/mangeshraut712/codex-insights#readme",
  "bugs": {
    "url": "https://github.com/mangeshraut712/codex-insights/issues"
  },
  "scripts": {
    "report": "node ./bin/codex-insights.js report",
    "report:lite": "node ./bin/codex-insights.js --preset lite --yes",
    "generate:test-report": "node ./scripts/generate-test-report.mjs",
    "test": "node --test",
    "check": "node ./scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "ci": "npm test && npm run check && npm pack --dry-run"
  },
  "keywords": [
    "codex",
    "openai",
    "insights",
    "cli",
    "plugin",
    "privacy",
    "local-first",
    "nodejs",
    "javascript",
    "html-report",
    "session-analysis",
    "developer-tools"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.8.6",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "typescript": "^5.9.3"
  }
}

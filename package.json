{
  "name": "@mangeshraut712/codex-insights",
  "version": "0.7.0",
  "description": "Private, trust-aware reports from local Codex sessions. Community $insights skill inspired by Claude Code /insights.",
  "author": {
    "name": "mangeshraut712",
    "email": "mbr63@drexel.edu",
    "url": "https://github.com/mangeshraut712"
  },
  "type": "module",
  "bin": {
    "codex-session-insights": "bin/codex-insights.js"
  },
  "files": [
    "bin",
    "lib",
    "plugin",
    "README.md",
    "LICENSE",
    "docs/*.md",
    "docs/screenshots/*.webp",
    "docs/adoption.json",
    "CONTRIBUTING.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mangeshraut712/codex-insights.git"
  },
  "homepage": "https://github.com/mangeshraut712/codex-insights#readme",
  "bugs": {
    "url": "https://github.com/mangeshraut712/codex-insights/issues"
  },
  "scripts": {
    "report": "node ./bin/codex-insights.js report",
    "report:lite": "node ./bin/codex-insights.js --preset lite --yes",
    "generate:test-report": "node ./scripts/generate-test-report.mjs",
    "generate:plugin-assets": "node ./scripts/generate-plugin-assets.mjs",
    "test": "node --test test/*.test.js",
    "lint": "eslint bin lib scripts test plugin/codex-insights/scripts",
    "check": "node ./scripts/check.mjs",
    "typecheck": "tsc --noEmit",
    "ci": "npm test && npm run lint && npm run check && npm pack --dry-run",
    "metrics": "python3 scripts/update-adoption.py"
  },
  "keywords": [
    "codex",
    "openai",
    "insights",
    "cli",
    "plugin",
    "privacy",
    "local-first",
    "nodejs",
    "javascript",
    "html-report",
    "session-analysis",
    "developer-tools",
    "agent-skills"
  ],
  "dependencies": {
    "@inquirer/prompts": "^8.8.0",
    "ora": "^10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.8"
  }
}
